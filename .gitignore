# ==========================================
# BlockBT - .gitignore
# ==========================================

# 1. Lokalne Dane & Bazy (KRYTYCZNE - Air-Gapped)
/local_data/
*.db
*.sqlite
*.sqlite3
*.parquet

# 2. Tajemnice (Zmienne Środowiskowe)
.env
.env.local
.env.*.local

# 3. Frontend (React / Node.js)
/frontend/node_modules/
/frontend/dist/
/frontend/build/
/frontend/.eslintcache
/frontend_old
/frontend_old/node_modules/
/frontend_old/dist/
/frontend_old/frontend_output.log/
/frontend_old/.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 4. Backend (Python / FastAPI)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.venv/
venv/
env/

# 5. Wygenerowane artefakty API (Opcjonalnie)
# Zostawiamy /frontend/src/services/api.d.ts w repo, aby inni mieli typy,
# ale ignorujemy sam surowy zrzut JSON:
openapi.json
/frontend/openapi.json

# 6. IDE / System operacyjny
.DS_Store
.idea/
.vscode/
*.swp

# 7. Silniki backtestingu pobierane lokalnie (BYOL — nie trafiają do repozytorium)
vectorbt/
vectorbt_src/
vectorbtpro/
/vectorbtpro_src/*
vectorbt.pro-main/
vectorbt.pro-main.zip

# 8. Dane i artefakty generowane w trakcie pracy
data/
/backend/data/
**/__pycache__/
*.pyc
*.log

# MkDocs build output — regenerowany z docs/, nie wersjonujemy
/site/

# Narzędzia agentowe działające lokalnie — konfiguracja jest prywatna
.claude/
.agents/
.opencode/
.windsurf/
.gemini/
/graphify-out/

# npm install odpalony w katalogu głównym zamiast frontend/ zostawia pusty lockfile
/package-lock.json

# Materiały prywatne i artefakty procesu publikacji. Trzymane lokalnie, nigdy w repo —
# jedno `git add -A` przywróciłoby do drzewa dokładnie to, co czyszczenie historii usuwa.
/TESTY_MANUALNE/
/HANDOFF*.md
*.bundle
