# ==========================================
# BlockBT - .gitignore
# ==========================================

# 1. Lokalne Dane & Bazy (KRYTYCZNE - Air-Gapped)
/local_data/
*.db
*.sqlite
*.sqlite3
*.parquet

# 2. Tajemnice (Zmienne Środowiskowe)
.env
.env.local
.env.*.local

# 3. Frontend (React / Node.js)
/frontend/node_modules/
/frontend/dist/
/frontend/build/
/frontend/.eslintcache
/frontend_old
/frontend_old/node_modules/
/frontend_old/dist/
/frontend_old/frontend_output.log/
/frontend_old/.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 4. Backend (Python / FastAPI)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.venv/
venv/
env/

# 5. Wygenerowane artefakty API (Opcjonalnie)
# Zostawiamy /frontend/src/services/api.d.ts w repo, aby inni mieli typy,
# ale ignorujemy sam surowy zrzut JSON:
openapi.json
/frontend/openapi.json

# 6. IDE / System operacyjny
.DS_Store
.idea/
.vscode/
*.swp

.agentignore
BOOTSTRAP.md
HEARTBEAT.md
IDENTITY.md
MEMORY.md
SOUL.md
TOOLS.md
USER.md
vectorbt.pro-main.zip
vectorbt.pro-main/*
vectorbtpro/*
.openclaw/*
data/
**/__pycache__/
*.pycvectorbt/
*.pyc
vectorbtpro/
vectorbt/
vectorbt.pro-main/
vectorbt_src/
/vectorbtpro_src/*

/backend/backend.log
/.github/copilot-instructions.md
/dep.log
# MkDocs build output — regenerowane z docs/, nie wersjonujemy (review 2026-07-15)
/site/

# Claude Code local working dir (worktrees, sesyjne ustawienia) — nie wersjonujemy
.claude/
