# BlockBT Configuration Template
# Copy this file to .env and populate your values.
# Never commit .env to version control.

# ── App ──────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=your_generated_fernet_key_here

# ── Database ─────────────────────────────────────────────────
# Default: SQLite at data/blockbt.db
# DATABASE_URL=sqlite:///data/blockbt.db
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost/blockbt

# ── Engine ───────────────────────────────────────────────────
# Path to vectorbtpro installation (BYOL). Leave blank to use OSS engine.
# VBTPRO_PATH=/path/to/vectorbtpro
PREFER_PRO_ENGINE=false

# ── Data Connectors ──────────────────────────────────────────
DATA_CONNECTOR=yahoo
PARQUET_CACHE_TTL_HOURS=24

# Alpaca (optional — BYOK)
# ALPACA_API_KEY=your_key_here
# ALPACA_SECRET_KEY=your_secret_here
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── AI / MCP ─────────────────────────────────────────────────
MCP_EQUITY_CURVE_MAX_POINTS=500
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_BASE_URL=http://localhost:11434

# --- User Management ---
# AUTH_ENABLED is stored in DB (AppSetting), not .env
# First admin account (created on first run with auth enabled):
ADMIN_USERNAME=admin
# ADMIN_PASSWORD celowo pozostaje ZAKOMENTOWANE.
# Bez tej zmiennej hasło pierwszego admina jest losowane i wypisywane JEDEN raz
# do logu (poziom WARNING) przy zakładaniu konta — zapisz je wtedy, bo nie da się
# go odczytać później. Odkomentuj wyłącznie, jeśli świadomie chcesz własne hasło;
# nigdy nie zostawiaj tu wartości przykładowej — trafi na wszystkie instalacje.
# ADMIN_PASSWORD=
